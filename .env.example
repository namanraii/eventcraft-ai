# Copy to .env and fill in only the providers you have.
# The planner runs fully without any key (deterministic engines).
# Provider order when several keys are set: SpaceXAI (xAI) -> Groq -> Gemini.

# Primary: SpaceXAI, served by the xAI API. https://docs.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1

# Optional fallbacks. Leave blank to skip.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Runtime guards
RATE_LIMIT_PER_MINUTE=60
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=128
